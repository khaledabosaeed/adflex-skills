#!/usr/bin/env bash
# adflex-skills setup: first-time installation for Claude Code, Cursor, Codex, etc.
# Idempotent: safe to run multiple times.
set -euo pipefail

# ─── Colors (degrade gracefully) ─────────────────────────────
if [ -t 1 ] && command -v tput &>/dev/null && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  GREEN=$(tput setaf 2) YELLOW=$(tput setaf 3) RED=$(tput setaf 1) BOLD=$(tput bold) RESET=$(tput sgr0)
else
  GREEN="" YELLOW="" RED="" BOLD="" RESET=""
fi

ok()   { echo "${GREEN}✓${RESET} $1"; }
warn() { echo "${YELLOW}!${RESET} $1"; }
err()  { echo "${RED}✗${RESET} $1"; }
info() { echo "${BOLD}→${RESET} $1"; }

MCP_NAME="adflex"
MCP_URL="https://api.adflex.ai/api/mcp"

# ─── Locate repo root ────────────────────────────────────────
REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ ! -f "$REPO_DIR/VERSION" ] || [ ! -d "$REPO_DIR/adflex-generate" ]; then
  err "Cannot find VERSION or adflex-generate/. Run this script from the adflex skills repo root."
  exit 1
fi

VERSION="$(tr -d '[:space:]' < "$REPO_DIR/VERSION")"
echo
echo "${BOLD}AdFlex Skills setup: v$VERSION${RESET}"
echo

# ─── Parse flags ────────────────────────────────────────────
HOST_OVERRIDE=""
TARGET_OVERRIDE=""
SKIP_MCP=0
while [ $# -gt 0 ]; do
  case "$1" in
    --host)
      shift
      [ $# -eq 0 ] && { err "--host requires a value: claude | cursor | codex"; exit 1; }
      HOST_OVERRIDE="$1"
      shift
      ;;
    --host=*)
      HOST_OVERRIDE="${1#--host=}"
      shift
      ;;
    --target-dir)
      shift
      [ $# -eq 0 ] && { err "--target-dir requires a directory"; exit 1; }
      TARGET_OVERRIDE="$1"
      shift
      ;;
    --skip-mcp) SKIP_MCP=1; shift ;;
    --help|-h)
      cat <<EOF
Usage: ./setup [options]

Options:
  --host <agent>      Force install path for: claude, cursor, codex
                      (auto-detected if omitted)
  --target-dir <dir>  Install links into this directory
  --skip-mcp          Don't register the AdFlex MCP connector
  --help              Show this message

Idempotent: safe to run multiple times.
EOF
      exit 0
      ;;
    *)
      warn "Unknown flag: $1"
      shift
      ;;
  esac
done

# ─── Detect agent host ──────────────────────────────────────
detect_host() {
  if [ -n "$HOST_OVERRIDE" ]; then
    echo "$HOST_OVERRIDE"
    return
  fi
  if [ -d "$HOME/.claude" ];  then echo "claude"; return; fi
  if [ -d "$HOME/.cursor" ];  then echo "cursor"; return; fi
  if [ -d "$HOME/.codex" ];   then echo "codex";  return; fi
  echo "unknown"
}

HOST="$(detect_host)"
case "$HOST" in
  claude)  TARGET_DIR="$HOME/.claude/skills" ;;
  cursor)  TARGET_DIR="$HOME/.cursor/skills" ;;
  codex)   TARGET_DIR="$HOME/.agents/skills" ;;
  unknown)
    warn "Could not auto-detect agent host."
    info "Re-run with --host <claude|cursor|codex>, or copy the adflex-* folders into your agent's skills directory."
    exit 1
    ;;
  *)
    err "Unknown host: $HOST"
    exit 1
    ;;
esac

[ -n "$TARGET_OVERRIDE" ] && TARGET_DIR="$TARGET_OVERRIDE"

SKILLS=(adflex-generate adflex-product-photo adflex-talking-ad adflex-carousel adflex-video-remix adflex-video-edit adflex-workflows adflex-documents adflex-brand adflex-social-publish adflex-reels)

ok "Detected host: $HOST"
ok "Target install path: $TARGET_DIR/<skill-name>"
echo

# ─── Step 1: AdFlex MCP connector ───────────────────────────
mcp_manual() {
  info "Add this MCP server to your agent, then sign in when it asks:"
  echo "    name: $MCP_NAME"
  echo "    type: http"
  echo "    url:  $MCP_URL"
}

if [ "$SKIP_MCP" -eq 1 ]; then
  warn "Skipping MCP connector registration (--skip-mcp)"
else
  case "$HOST" in
    claude)
      if ! command -v claude &>/dev/null; then
        warn "'claude' CLI not on PATH."
        mcp_manual
      elif claude mcp get "$MCP_NAME" &>/dev/null; then
        ok "AdFlex MCP connector already registered in Claude Code"
      elif claude mcp add --transport http --scope user "$MCP_NAME" "$MCP_URL" &>/dev/null; then
        ok "AdFlex MCP connector registered in Claude Code (user scope)"
      else
        err "Could not register the connector automatically."
        info "Run: claude mcp add --transport http --scope user $MCP_NAME $MCP_URL"
      fi
      info "In Claude Code, run /mcp and sign in to AdFlex."
      ;;
    codex)
      if command -v codex &>/dev/null && codex mcp get "$MCP_NAME" &>/dev/null; then
        ok "AdFlex MCP connector already registered in Codex"
      elif command -v codex &>/dev/null && codex mcp add "$MCP_NAME" --url "$MCP_URL" &>/dev/null; then
        ok "AdFlex MCP connector registered in Codex"
        info "Sign in with: codex mcp login $MCP_NAME"
      else
        warn "Could not register the connector in Codex automatically."
        mcp_manual
      fi
      ;;
    cursor)
      CURSOR_MCP="$HOME/.cursor/mcp.json"
      if [ -f "$CURSOR_MCP" ] && grep -q "$MCP_URL" "$CURSOR_MCP"; then
        ok "AdFlex MCP connector already in $CURSOR_MCP"
      elif [ ! -f "$CURSOR_MCP" ]; then
        mkdir -p "$(dirname "$CURSOR_MCP")"
        printf '{\n  "mcpServers": {\n    "%s": { "url": "%s" }\n  }\n}\n' "$MCP_NAME" "$MCP_URL" > "$CURSOR_MCP"
        ok "Created $CURSOR_MCP with the AdFlex connector"
      else
        warn "$CURSOR_MCP exists; not editing it automatically."
        mcp_manual
      fi
      info "In Cursor, open Settings → MCP and sign in to AdFlex."
      ;;
  esac
fi
echo

# ─── Step 2: Install skills ─────────────────────────────────
mkdir -p "$TARGET_DIR"
for skill in "${SKILLS[@]}"; do
  src="$REPO_DIR/$skill"
  dst="$TARGET_DIR/$skill"
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    ok "$skill already linked"
  elif [ -e "$dst" ] || [ -L "$dst" ]; then
    warn "$dst exists and is not a link to this repo; leaving it alone"
  else
    ln -s "$src" "$dst"
    ok "Linked $skill"
  fi
done
echo

ok "Done. Skills installed: ${SKILLS[*]}"
info "Try: \"Make a 9:16 product ad with AdFlex\""
echo
